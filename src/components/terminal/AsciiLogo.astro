---
import { asciiLogo } from '../../data/ascii-logo';

interface Props {
	/** Accessible name; omit when the art is decorative. */
	label?: string;
	/** Decode-in + ambient glitch (see src/scripts/anim/ascii.ts). */
	animate?: boolean;
	class?: string;
}

const { label, animate = false, class: className } = Astro.props;
const a11y: Record<string, string> = label
	? { role: 'img', 'aria-label': label }
	: { 'aria-hidden': 'true' };

const art = asciiLogo;
---

<pre
	class:list={['ascii-logo', className]}
	data-ascii-animate={animate ? '' : undefined}
	{...a11y}
>{art}</pre>

<style>
	.ascii-logo {
		font-family: inherit;
		/* ≥12px keeps it legible (and fits 40 cols on a 320px screen). */
		font-size: clamp(0.75rem, 0.6rem + 0.4vw, 0.8125rem);
		line-height: 1.12;
		color: var(--color-accent);
		text-shadow: var(--glow);
		white-space: pre;
		width: max-content;
		margin-inline: auto;
	}

	/* Hidden until the decode starts; reveals itself anyway if the script never runs. */
	:global(html.motion-on) .ascii-logo[data-ascii-animate]:not(.is-ready) {
		visibility: hidden;
		animation: ascii-fallback 0s 1.5s forwards;
	}

	:global(html.motion-on) .ascii-logo {
		--glow: 0 0 10px rgb(111 179 184 / 0.35);
	}

	@keyframes ascii-fallback {
		to {
			visibility: visible;
		}
	}
</style>
