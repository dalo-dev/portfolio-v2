---
import { profile } from '../../data/site';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getIcon } from '../../lib/icons';

interface Props {
	lang: Lang;
	class?: string;
}

const { lang, class: className } = Astro.props;
const t = useTranslations(lang);

// Simple Icons dropped LinkedIn at LinkedIn's request; this is its standard monochrome mark.
const linkedinPath =
	'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const links = [
	{ label: 'GitHub', href: profile.github, path: getIcon('github').path, rel: 'me noopener' },
	{ label: 'LinkedIn', href: profile.linkedin, path: linkedinPath, rel: 'me noopener' },
	{ label: t('social.email'), href: `mailto:${profile.email}`, path: undefined, rel: undefined },
];
---

<ul class:list={['social', className]}>
	{links.map((link) => (
		<li>
			<a href={link.href} rel={link.rel}>
				{link.path ? (
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
						<path d={link.path} />
					</svg>
				) : (
					<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="social__stroke">
						<rect x="2.5" y="4.5" width="19" height="15" rx="2" />
						<path d="m3 6 9 7 9-7" />
					</svg>
				)}
				{link.label}
			</a>
		</li>
	))}
</ul>

<style>
	.social {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-5);
		font-size: var(--text-sm);
	}

	.social a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--target-min);
		color: var(--color-muted);
		text-decoration: none;
	}

	.social a:hover {
		color: var(--color-heading);
		text-decoration: underline;
	}

	.social svg {
		width: 1.125rem;
		height: 1.125rem;
		flex: none;
		fill: currentColor;
	}

	.social svg.social__stroke {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linejoin: round;
	}
</style>
