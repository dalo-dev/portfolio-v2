---
import type { CollectionEntry } from 'astro:content';
import TagList from './TagList.astro';
import { profile } from '../../data/site';
import type { Lang } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/utils';
import { slugOf } from '../../lib/content';

interface Props {
	project: CollectionEntry<'projects'>;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const slug = slugOf(project);
const href = localizePath(lang, `projects/${slug}`);
const { title, summary, stack, repo, live } = project.data;
const liveHost = live ? new URL(live).hostname.replace(/^www\./, '') : undefined;
---

<article class="card">
	<p class="card__bar" aria-hidden="true">
		drwxr-xr-x {profile.handle}{' '}
		<span class="card__dir" data-scramble>
			{slug}/
		</span>
	</p>
	<div class="card__body">
		<h3 class="card__title" transition:name={`project-title-${slug}`}>
			<a href={href}>{title}</a>
		</h3>
		<p class="card__summary">{summary}</p>
		<TagList items={stack} label={t('projects.stack')} />
		<ul class="card__links">
			<li>
				<a href={href}>
					<span class="glyph" aria-hidden="true">
						{'→ '}
					</span>
					{t('projects.details')}
					<span class="visually-hidden">: {title}</span>
				</a>
			</li>
			{repo && (
				<li>
					<a href={repo} rel="noopener">
						<span class="glyph" aria-hidden="true">
							{'→ '}
						</span>
						{t('projects.source')}
						<span class="visually-hidden">: {title}</span>
					</a>
				</li>
			)}
			{live && (
				<li>
					<a href={live} rel="noopener">
						<span class="glyph" aria-hidden="true">
							{'→ '}
						</span>
						{liveHost}
						<span class="visually-hidden">
							{' '}
							({t('projects.live')}: {title})
						</span>
					</a>
				</li>
			)}
		</ul>
	</div>
</article>

<style>
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
		transition: border-color var(--duration-fast) ease;
	}

	.card:hover,
	.card:focus-within {
		border-color: var(--color-border-strong);
	}

	.card__bar {
		padding: var(--space-2) var(--space-4);
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg-sunken);
		font-size: var(--text-xs);
		color: var(--color-muted);
		white-space: pre;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.card__dir {
		color: var(--color-heading);
	}

	.card__body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-5);
	}

	.card__title {
		font-size: var(--text-lg);
	}

	.card__title a {
		color: var(--color-heading);
		text-decoration: none;
	}

	.card__title a:hover {
		text-decoration: underline;
	}

	.card__summary {
		flex: 1;
		font-size: var(--text-sm);
	}

	.card__links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--space-5);
		font-size: var(--text-sm);
	}

	.card__links a {
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		color: var(--color-accent);
	}

	.card__links a:hover {
		color: var(--color-accent-hover);
	}
</style>
