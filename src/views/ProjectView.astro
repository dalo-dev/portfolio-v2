---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/terminal/Prompt.astro';
import TagList from '../components/ui/TagList.astro';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import { slugOf } from '../lib/content';

interface Props {
	project: CollectionEntry<'projects'>;
	lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const slug = slugOf(project);
const { title, summary, stack, repo, live } = project.data;
const { Content } = await render(project);
const back = `${localizePath(lang)}#projects`;
---

<BaseLayout lang={lang} title={title} description={summary} ogType="article">
	<article class="project container">
		<a class="project__back" href={back}>
			<span class="glyph" aria-hidden="true">
				{'$ '}
			</span>
			{t('projects.back')}
			<span class="visually-hidden">— {t('projects.title')}</span>
		</a>
		<Prompt command={`cat ~/projects/${slug}/README.md`} />
		<h1 class="project__title">{title}</h1>
		<p class="project__summary">{summary}</p>
		<TagList items={stack} label={t('projects.stack')} />
		{(repo || live) && (
			<ul class="project__links">
				{repo && (
					<li>
						<a class="btn btn--outline" href={repo} rel="noopener">
							<span class="glyph" aria-hidden="true">
								{'→ '}
							</span>
							{t('projects.source')}
						</a>
					</li>
				)}
				{live && (
					<li>
						<a class="btn btn--solid" href={live} rel="noopener">
							<span class="glyph" aria-hidden="true">
								{'→ '}
							</span>
							{t('projects.live')}
						</a>
					</li>
				)}
			</ul>
		)}
		{project.body?.trim() && (
			<div class="prose">
				<Content />
			</div>
		)}
	</article>
</BaseLayout>

<style>
	.project {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-block: var(--space-10) var(--space-section);
		max-width: calc(var(--prose-max) + 2 * var(--gutter));
	}

	.project__back {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		min-height: var(--target-min);
		margin-bottom: var(--space-4);
		color: var(--color-muted);
		text-decoration: none;
	}

	.project__back:hover {
		color: var(--color-heading);
	}

	.project__title {
		font-size: var(--text-hero);
		letter-spacing: -0.02em;
	}

	.project__summary {
		font-size: var(--text-md);
	}

	.project__links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	.prose {
		margin-top: var(--space-8);
		padding-top: var(--space-8);
		border-top: 1px solid var(--color-border);
	}

	.prose :global(> * + *) {
		margin-top: var(--space-4);
	}

	.prose :global(h2) {
		margin-top: var(--space-10);
		font-size: var(--text-xl);
	}

	.prose :global(h2::before) {
		content: '## ';
		color: var(--color-muted);
	}

	.prose :global(ul) {
		padding-left: var(--space-6);
	}

	.prose :global(code) {
		padding: 0.1em 0.35em;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		color: var(--color-heading);
	}
</style>
