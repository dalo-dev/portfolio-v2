---
import { Picture } from 'astro:assets';
import Section from '../Section.astro';
import TerminalWindow from '../terminal/TerminalWindow.astro';
import profilePhoto from '../../assets/images/me.jpg';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Section id="about" title={t('about.title')} command="cat about.md">
	<TerminalWindow slot="aside" title="imgcat ~/me.jpg" class="about__photo">
		<Picture
			src={profilePhoto}
			alt={t('about.photo.alt')}
			widths={[280, 560]}
			sizes="17.5rem"
			formats={['avif', 'webp']}
			class="about__img"
		/>
	</TerminalWindow>
	<div class="about__text">
		<p>{t('about.p1')}</p>
		<p>{t('about.p2')}</p>
	</div>
</Section>

<style>
	.about__text {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		max-width: var(--prose-max);
	}

	:global(.about__photo) {
		width: min(100%, 17.5rem);
	}

	:global(.about__img) {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
	}
</style>
