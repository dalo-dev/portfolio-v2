---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/terminal/Prompt.astro';
import type { Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notFound.title')} noindex>
	<section class="nf container" aria-labelledby="nf-title">
		<Prompt command="cd ./this-page" />
		<p class="nf__error" aria-hidden="true">
			bash: cd: ./this-page: {t('notFound.message')}
		</p>
		<h1 id="nf-title" class="nf__title">
			404 · {t('notFound.title')}
		</h1>
		<p>{t('notFound.hint')}</p>
		<a class="btn btn--solid nf__home" href={localizePath(lang)}>
			{t('notFound.home')}
		</a>
	</section>
</BaseLayout>

<style>
	.nf {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-block: var(--space-section);
	}

	.nf__error {
		color: var(--color-muted);
	}

	.nf__title {
		margin-top: var(--space-4);
		font-size: var(--text-hero);
	}

	.nf__home {
		align-self: flex-start;
		margin-top: var(--space-4);
	}
</style>
