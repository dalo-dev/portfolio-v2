---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Hidden until the animation script wires it up (no JS → nothing to pause). -->
<button type="button" class="toggle" data-motion-toggle aria-pressed="false" hidden>
	<span class="toggle__icon" aria-hidden="true"></span>
	{t('motion.pause')}
</button>

<style>
	.toggle {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.25rem;
		padding-inline: var(--space-3);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		background: transparent;
		color: var(--color-heading);
		font-size: var(--text-sm);
		cursor: pointer;
	}

	.toggle[hidden] {
		display: none;
	}

	.toggle:hover {
		border-color: var(--color-muted);
	}

	.toggle__icon::before {
		content: '❚❚';
		font-size: 0.75em;
	}

	.toggle[aria-pressed='true'] {
		border-color: var(--color-accent);
	}

	.toggle[aria-pressed='true'] .toggle__icon::before {
		content: '▶';
		color: var(--color-accent);
	}
</style>
