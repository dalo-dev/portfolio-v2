---
import Section from '../Section.astro';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getSkills } from '../../lib/content';
import { getIcon } from '../../lib/icons';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = (await getSkills()).map(({ data }) => ({
	id: data.id,
	label: t(`skills.${data.id}`),
	items: data.items.map((item) => ({ ...item, icon: getIcon(item.icon) })),
}));
const fileCount = groups.reduce((sum, group) => sum + group.items.length, 0);
---

<Section id="skills" title={t('skills.title')} command="tree ~/skills">
	<div class="skills">
		{groups.map((group) => (
			<section
				class:list={['group', `group--${group.id}`]}
				aria-labelledby={`skills-${group.id}`}
				data-reveal-item
			>
				<h3 class="group__title" id={`skills-${group.id}`}>
					{group.label}/
				</h3>
				<ul class="group__items">
					{group.items.map((item) => (
						<li class="skill" style={`--brand: ${item.icon.color}`}>
							<svg class="skill__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path d={item.icon.path} />
							</svg>
							{item.name}
						</li>
					))}
				</ul>
			</section>
		))}
	</div>
	<p class="skills__summary" aria-hidden="true">
		{groups.length} directories, {fileCount} files
	</p>
</Section>

<style>
	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-5);
	}

	/* "core" leads the grid at full width. */
	.group--core {
		grid-column: 1 / -1;
	}

	.group {
		position: relative;
		padding: var(--space-6) var(--space-5) var(--space-5);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}

	/* Folder name sits on the border, like a terminal box title. */
	.group__title {
		position: absolute;
		top: 0;
		left: var(--space-4);
		transform: translateY(-50%);
		padding-inline: var(--space-2);
		background: var(--color-bg);
		font-size: var(--text-sm);
		color: var(--color-heading);
	}

	.group__items {
		list-style: none;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.skill {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border-strong);
		border-radius: var(--radius);
		background: var(--color-bg-sunken);
		font-size: var(--text-sm);
		color: var(--color-text);
		transition:
			border-color var(--duration) ease,
			color var(--duration) ease;
	}

	.skill__icon {
		width: 1.125rem;
		height: 1.125rem;
		flex: none;
		fill: var(--color-muted);
		transition: fill var(--duration) ease;
	}

	/* Muted at rest; the brand colour shows on hover. */
	.skill:hover {
		border-color: var(--brand);
		color: var(--color-heading);
	}

	.skill:hover .skill__icon {
		fill: var(--brand);
	}

	.skills__summary {
		margin-top: var(--space-6);
		font-size: var(--text-sm);
		color: var(--color-muted);
	}
</style>
